# Salin file ini ke .env dan sesuaikan nilainya

# Google Cloud project ID kamu
GOOGLE_CLOUD_PROJECT=gen-lang-client-0453667461

# Region Google Cloud (contoh: us-central1, asia-southeast1)
GOOGLE_CLOUD_LOCATION=asia-southeast1

# Token rahasia untuk melindungi backend (buat sendiri, bebas)
# Ini yang diisi di field "API Configuration" di sidebar
PROXY_HEADER=ugc8s-demo-123

# Port backend (default 5000)
# API_BACKEND_PORT=5000
