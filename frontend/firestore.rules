rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quota', 'jobCount', 'displayName'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['quota'])
          || (
            request.resource.data.quota.videoUsed is int
            && request.resource.data.quota.imageUsed is int
            && request.resource.data.quota.videoUsed >= 0
            && request.resource.data.quota.imageUsed >= 0
            && request.resource.data.quota.videoUsed <= 10
            && request.resource.data.quota.imageUsed <= 20
          )
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
